{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Document Tracker",
  "version": "1.0.0",
  "identifier": "com.pmo.dmts",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Document Tracker",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
